# libFuzzer dictionary for the http-net targets: the bytes and words that
# decide framing, so mutations reach the interesting rules quickly.
crlf="\x0d\x0a"
blank="\x0d\x0a\x0d\x0a"
cr="\x0d"
lf="\x0a"
sp=" "
htab="\x09"
colon=":"
semi=";"
comma=","
eq="="
quote="\x22"
bslash="\x5c"
pct="%"
nul="\x00"
del="\x7f"
obs="\x80"
get="GET"
head="HEAD"
post="POST"
put="PUT"
connect="CONNECT"
options="OPTIONS"
pri="PRI * HTTP/2.0"
star="*"
slash="/"
http10="HTTP/1.0"
http11="HTTP/1.1"
http19="HTTP/1.9"
http20="HTTP/2.0"
status200="HTTP/1.1 200 OK"
status100="HTTP/1.1 100 Continue"
status101="HTTP/1.1 101 Switching Protocols"
status204="HTTP/1.1 204"
host="Host: "
cl="Content-Length: "
te="Transfer-Encoding: "
chunked="chunked"
gzip="gzip"
conn="Connection: "
close="close"
keepalive="keep-alive"
upgrade="Upgrade: "
upgradetok="upgrade"
websocket="websocket"
h2c="h2c"
expect="Expect: "
cont="100-continue"
trailer="Trailer: "
cookie="Cookie: "
auth="Authorization: "
abs="http://"
port=":80"
ipv6="[::1]"
last="0\x0d\x0a\x0d\x0a"
ext=";a=b"
qext=";a=\x22b\x22"
hex16="ffffffffffffffff"
zeros="00000000000000001"
